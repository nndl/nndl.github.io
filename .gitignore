.jekyll-cache/
.jekyll-metadata
Gemfile.lock
.bundle/
vendor/

# Claude Code local config
.claude/

# Python (scripts/)
__pycache__/
*.pyc

# Star counts: regenerated by .github/workflows/pages.yml on every deploy.
# Locally optional — run scripts/fetch-gh-stars.py to populate for preview.
_data/gh_stars.yml

# CSS content hash: stamped by .github/workflows/pages.yml at build time for
# cache-busting. Never committed; default.html falls back to build time locally.
_data/build.yml
