source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "webrick", "~> 1.8"

# Jekyll plugins (also on GitHub Pages whitelist)
gem "jekyll-redirect-from", "~> 0.16"
gem "jekyll-sitemap", "~> 1.4"

# Windows / JRuby tzinfo support
platforms :mingw, :x64_mingw, :mswin do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
